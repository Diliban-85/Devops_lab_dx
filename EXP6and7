sudo apt update
sudo apt install ansible -y
ansible --version
mkdir ~/ansible_webapp
cd ~/ansible_webapp
#create file 
nano inventory
#paste it ...
[webservers]
localhost ansible_connection=local
//


nano playbook.yml
---
- name: Deploy Simple Web Application
  hosts: webservers
  become: yes

  tasks:
    - name: Install Apache
      apt:
        name: apache2
        state: present
        update_cache: yes

    - name: Start Apache
      service:
        name: apache2
        state: started
        enabled: yes

    - name: Create web page
      copy:
        content: "<h1>Welcome to Ansible Web Application</h1>"
        dest: /var/www/html/index.html

//////////////////////

nano ansible.cfg
[defaults]
timeout = 30

[privilege_escalation]
become_timeout = 60
