EXP 7: SImple Application Using Gradle.

2. Procedure
Step 1: Install Java
sudo apt update
sudo apt install openjdk-21-jdk -y

sudo apt install gradle -y
gradle --version

mkdir ~/gradle_app
cd ~/gradle_app

Create the Java source directory:
mkdir -p src/main/java

Step 4: Create the Java program
nano src/main/java/App.java

public class App {
    public static void main(String[] args) {
        System.out.println("Hello World!");
        System.out.println("Gradle Application Executed Successfully");
    }
}

Step 5: Create the Gradle build file
nano build.gradle

plugins {
    id 'application'
}

application {
    mainClass = 'App'
}
------
(or)

apply plugin: 'java'
apply plugin: 'application'

mainClassName = 'Hello'

