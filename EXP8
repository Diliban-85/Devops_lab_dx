nano roles/webserver/tasks/main.yml

---
- name: Install Apache
  apt:
    name: "{{ webserver_package }}"
    state: present
    update_cache: yes

- name: Start Apache
  service:
    name: "{{ webserver_service }}"
    state: started
    enabled: yes

////////////

nano roles/webserver/handlers/main.yml

---
- name: Restart Apache
  service:
    name: apache2
    state: restarted
///////
nano playbook.yml

---
- name: Configure Web Server Using Ansible Role
  hosts: webservers
  become: yes

  roles:
    - webserver

///////

