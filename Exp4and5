MyFirstCD pipeline script:

pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'mkdir -p deploy'
                sh 'echo "Hello from Jenkins CD Pipeline!" > deploy/index.html'
            }
        }

        stage('Deploy') {
            steps {
                sh 'sudo cp deploy/index.html /var/www/html/index.html'
                sh 'cat /var/www/html/index.html'
            }
        }
    }
}

